{
  "name": "dsh-unified-memory",
  "version": "2.1.6",
  "description": "A local-first long-term memory plugin for DSH: four-force decay, BM25 + vector + hypergraph retrieval, L0/L1/L2 layering, and a dispatch receipt state machine.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js"
  },
  "files": [
    "lib/",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "docs/configuration.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1 <0.3.0",
      "node": ">=22.15"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "engines": {
    "node": ">=22.15"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "*"
  },
  "scripts": {
    "smoke": "node scripts/smoke-apply.mjs",
    "check": "node scripts/smoke-apply.mjs && node scripts/check-tracked-imports.mjs && node scripts/check-syntax.mjs && node scripts/check-hardcodes.mjs && node scripts/check-personal-data.mjs",
    "check:as-stranger": "node scripts/check-as-stranger.mjs",
    "check:release": "npm run check && node scripts/check-as-stranger.mjs --full && npm run audit && npm run check:package",
    "check:package": "node scripts/check-package-contents.mjs",
    "audit": "node scripts/security-audit.mjs && node scripts/data-leak-audit.mjs",
    "structure": "node scripts/gen-structure.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/txjyt0599-cell/dsh-unified-memory.git"
  },
  "homepage": "https://github.com/txjyt0599-cell/dsh-unified-memory#readme",
  "bugs": {
    "url": "https://github.com/txjyt0599-cell/dsh-unified-memory/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "memory",
    "long-term-memory",
    "rag",
    "bm25",
    "hypergraph",
    "local-first"
  ],
  "license": "SEE LICENSE IN LICENSE",
  "private": false,
  "devDependencies": {
    "js-yaml": "^4.1.0"
  }
}
