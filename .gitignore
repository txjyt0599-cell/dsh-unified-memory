# dependencies
node_modules/

# Literal "~" directory at repo root
#   Some tests pass "~/.dsh/..." as a *string* instead of expanding it, so Node
#   creates a real ./~ directory. It contains logs and generated config —
#   must never be committed.
~/

# Runtime data (never commit).
#   Keep the leading slash: a bare name like "hypergraph/" would also match
#   lib/hypergraph/ and silently exclude source code from clones.
/data/
/*.jsonl
/*.jsonl.zstd
/*.zstd
/logs/
/reports/
/embeddings/
/hypergraph/
/dispatch/
/conversations/

# Generated structure snapshot (recreate with `npm run structure`)
/docs/structure.json

# Local config and secrets (may contain API keys)
.env
.env.*
*.local.json
cordis.local.yml

# Test scratch
_test-root/
_sanitize-backup/
_ingest-out.txt

# OS / editors
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/
.idea/
