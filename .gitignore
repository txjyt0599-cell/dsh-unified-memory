# dependencies
node_modules/

# Literal "~" directory at repo root
#   Some tests pass "~/.dsh/..." as a *string* instead of expanding it, so Node
#   creates a real ./~ directory. It contains logs and generated config —
#   must never be committed.
~/

# runtime data (never commit)
data/
*.jsonl
*.jsonl.zstd
*.zstd
logs/
reports/
embeddings/
hypergraph/
dispatch/
conversations/

# sanitize scratch
_sanitize-backup/

# local config (may contain keys)
.env
.env.*
*.local.json
cordis.local.yml

# OS / editors
.DS_Store
Thumbs.db
*.log
*.tmp
.vscode/
.idea/
